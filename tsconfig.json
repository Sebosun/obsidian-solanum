{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["./src/*"], "@assets/*": ["./assets/*"] },
    "resolveJsonModule": true,
    "lib": ["DOM", "ES2020"],
    "types": ["node", "react", "react-dom"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/browser/server.mjs",
    "playwright.config.ts",
    "vitest.config.mts"
  ]
}
